{
  "rules": {
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "players": {
          "$pid": {
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" }
          }
        }
      }
    }
  }
}
